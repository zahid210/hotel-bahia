# Copia este archivo a .env y ajusta los valores si lo necesitas.
# docker compose lee .env automáticamente; todo tiene default seguro para dev.
#
#   cp .env.example .env
#   docker compose up -d --build

# ── Base de datos ──────────────────────────────────────────────
DB_NAME=hotel_bahia
DB_USER=hotel
DB_PASSWORD=hotel_bahia
DB_ROOT_PASSWORD=root_local

# ── Backend ────────────────────────────────────────────────────
# Para producción en un servidor expuesto, cambia JWT_SECRET por un valor
# largo y aleatorio (ej: openssl rand -base64 48).
JWT_SECRET=local-dev-secret-key-for-hotel-bahia-not-for-production-use-only-32chars!!
JWT_EXPIRATION_MS=86400000
APP_TIMEZONE=America/Lima